// PCB Plotter resources: icon, manifest, version
#include <windows.h>
1 ICON "app.ico"
// Explorer file-type icons (tools/make_icons.py). Referenced by the registry as "PCBPlotter.exe,-<id>":
// ids are stable, never renumber (src/platform/win_shell.h IconId).
101 ICON "icons/pcbp.ico"
102 ICON "icons/cpf.ico"
103 ICON "icons/vmjob.ico"
104 ICON "icons/gerber.ico"
105 ICON "icons/odb.ico"
106 ICON "icons/ipc.ico"
107 ICON "icons/pnp.ico"
108 ICON "icons/sheet.ico"
120 ICON "icons/import.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
// R12 (specs/SMARTSCREEN.md): complete, consistent version metadata. Keep FILEVERSION / PRODUCTVERSION and the
// string values in step with the release; SmartScreen reputation is tied to the signed publisher + file identity.
#define PCBP_VER_BIN 1,21,0,0
#define PCBP_VER_STR "1.21.0.0"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION PCBP_VER_BIN
 PRODUCTVERSION PCBP_VER_BIN
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Corey Nguyen"
      VALUE "FileDescription", "PCB Plotter - SMT CAM and placement programming"
      VALUE "FileVersion", PCBP_VER_STR
      VALUE "InternalName", "PCBPlotter"
      VALUE "LegalCopyright", "Public domain (The Unlicense), Corey Nguyen"
      VALUE "OriginalFilename", "PCBPlotter.exe"
      VALUE "ProductName", "PCB Plotter"
      VALUE "ProductVersion", PCBP_VER_STR
      VALUE "Comments", "SMT assembly CAM: CAD / Gerber / BOM data to panels, reports and pick-and-place programs"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
