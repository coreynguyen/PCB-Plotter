# Cross toolchain: Linux host -> x86_64 Windows (Debian/Ubuntu: apt install mingw-w64 cmake ninja-build)
# Override the prefix for other distros, e.g. -DMINGW_PREFIX=x86_64-w64-mingw32ucrt (Fedora ucrt64).
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT MINGW_PREFIX)
  set(MINGW_PREFIX x86_64-w64-mingw32)
endif()
find_program(_cxx_posix ${MINGW_PREFIX}-g++-posix)   # prefer the posix thread model where installed
if(_cxx_posix)
  set(CMAKE_C_COMPILER   ${MINGW_PREFIX}-gcc-posix)
  set(CMAKE_CXX_COMPILER ${MINGW_PREFIX}-g++-posix)
else()
  set(CMAKE_C_COMPILER   ${MINGW_PREFIX}-gcc)
  set(CMAKE_CXX_COMPILER ${MINGW_PREFIX}-g++)
endif()
set(CMAKE_RC_COMPILER ${MINGW_PREFIX}-windres)
set(CMAKE_FIND_ROOT_PATH /usr/${MINGW_PREFIX})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
# Run cross-built test/tool exes through Wine when present (ctest on the cross preset)
find_program(_wine NAMES wine64 wine)
if(_wine)
  set(CMAKE_CROSSCOMPILING_EMULATOR ${_wine})
endif()
