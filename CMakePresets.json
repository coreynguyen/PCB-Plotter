{
  "version": 3,
  "configurePresets": [
    { "name": "mingw-cross", "displayName": "Linux -> Windows x64 (MinGW-w64)",
      "generator": "Ninja", "binaryDir": "build/mingw-cross",
      "toolchainFile": "cmake/toolchain-mingw64.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "mingw-native", "displayName": "Windows MSYS2 UCRT64/MINGW64 native",
      "generator": "Ninja", "binaryDir": "build/mingw-native",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "linux-tests", "displayName": "Linux native: portable core + unit tests",
      "generator": "Ninja", "binaryDir": "build/linux-tests",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "PCBP_BUILD_TESTS": "ON", "PCBP_BUILD_APP": "OFF" } },
    { "name": "mingw-cross-tests", "displayName": "Linux -> Windows x64 + tests under Wine",
      "inherits": "mingw-cross", "binaryDir": "build/mingw-cross-tests",
      "cacheVariables": { "PCBP_BUILD_TESTS": "ON" } }
  ],
  "buildPresets": [
    { "name": "mingw-cross", "configurePreset": "mingw-cross" },
    { "name": "mingw-native", "configurePreset": "mingw-native" },
    { "name": "linux-tests", "configurePreset": "linux-tests" },
    { "name": "mingw-cross-tests", "configurePreset": "mingw-cross-tests" }
  ],
  "testPresets": [
    { "name": "linux-tests", "configurePreset": "linux-tests", "output": { "outputOnFailure": true } },
    { "name": "mingw-cross-tests", "configurePreset": "mingw-cross-tests", "output": { "outputOnFailure": true } }
  ]
}
